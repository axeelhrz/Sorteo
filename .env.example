# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# EmailJS Configuration (obligatorio para envío de correos desde el servidor)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=wp08DHZOgU6CgICb1
# Clave privada: EmailJS > Account > API Keys. Activa "Allow API requests from non-browser applications" en Security.
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=service_sovfqju
# Plantillas: IDs de plantillas creadas en https://dashboard.emailjs.com/admin/templates (copia el ID exacto de cada plantilla)
EMAILJS_TEMPLATE_WINNER_NOTIFICATION=
EMAILJS_TEMPLATE_ORGANIZER_RAFFLE_FINISHED=
EMAILJS_TEMPLATE_ORGANIZER_PAYMENT_DONE=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Job Secret (for Vercel Cron Jobs)
CRON_SECRET=your_random_secret_key_here